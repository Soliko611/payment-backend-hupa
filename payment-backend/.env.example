NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/wallet
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=1h
# Production automatically enables Secure cookies; this flag is for local HTTPS setups.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,https://soli-demo.onrender.com
PG_POOL_MAX=10
